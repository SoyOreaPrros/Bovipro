<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650" prefWidth="1000" style="-fx-background-color: #f0f7f2;"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controllers.TratamientoController">
    <stylesheets><URL value="@estilo.css"/></stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="header-bar">
            <Button onAction="#irDashboard"
                    style="-fx-background-color: #3a8060; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 4;
                           -fx-cursor: hand; -fx-padding: 6 14;" text="← Dashboard"/>
            <Label styleClass="header-titulo" text="💊 Tratamientos"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabsTrat" style="-fx-background-color: #f0f7f2; -fx-tab-min-width: 150;"
                 tabClosingPolicy="UNAVAILABLE">

            <!-- ══ PESTAÑA 1 — Agregar ══ -->
            <Tab text="➕  Nuevo tratamiento">
                <ScrollPane fitToWidth="true">
                    <VBox spacing="16" style="-fx-padding: 24; -fx-background-color: #f0f7f2;">
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"
                               text="Registrar nuevo tratamiento"/>

                        <!-- Animal y estado -->
                        <VBox style="-fx-padding: 16; -fx-background-color: white;
                              -fx-border-color: #c8ddc8; -fx-border-radius: 6;
                              -fx-background-radius: 6; -fx-spacing: 10;">
                            <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4a9b6f;"
                                   text="DATOS GENERALES"/>
                            <Separator/>
                            <HBox spacing="20">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Animal *"/>
                                    <ComboBox fx:id="cmbMascota" maxWidth="Infinity" promptText="-- Selecciona --"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Estado"/>
                                    <ComboBox fx:id="cmbEstado" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- PLAN TERAPÉUTICO -->
                        <VBox style="-fx-padding: 16; -fx-background-color: white;
                              -fx-border-color: #c8ddc8; -fx-border-radius: 6;
                              -fx-background-radius: 6; -fx-spacing: 10;">
                            <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4a9b6f;"
                                   text="PLAN TERAPÉUTICO"/>
                            <Separator/>

                            <!-- Fila de entrada -->
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="txtPrincipioActivo" promptText="Principio activo"
                                           HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="txtDosis" promptText="Dosis" prefWidth="90"/>
                                <TextField fx:id="txtVia" promptText="Vía" prefWidth="90"/>
                                <TextField fx:id="txtFrecuencia" promptText="Frecuencia" prefWidth="120"/>
                                <Button text="+ Agregar" onAction="#onAgregarMedicamento"
                                        style="-fx-background-color: #4a9b6f; -fx-text-fill: white;
                                               -fx-font-weight: bold; -fx-background-radius: 6;
                                               -fx-cursor: hand; -fx-padding: 8 18;"/>
                            </HBox>

                            <!-- Tabla de medicamentos -->
                            <TableView fx:id="tablaMedicamentos" prefHeight="180">
                                <placeholder>
                                    <Label text="Tabla sin contenido"
                                           style="-fx-font-style: italic; -fx-text-fill: #aaa;"/>
                                </placeholder>
                                <columns>
                                    <TableColumn fx:id="colMedicamento" text="Medicamento" prefWidth="300"/>
                                    <TableColumn fx:id="colDosis"       text="Dosis"       prefWidth="100"/>
                                    <TableColumn fx:id="colVia"         text="Vía"         prefWidth="100"/>
                                    <TableColumn fx:id="colFrecuencia"  text="Frecuencia"  prefWidth="150"/>
                                </columns>
                            </TableView>

                            <Button text="🗑 Quitar seleccionado" onAction="#onQuitarMedicamento"
                                    style="-fx-background-color: #e53935; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-background-radius: 6;
                                           -fx-cursor: hand; -fx-padding: 8 18;"/>
                        </VBox>

                        <!-- Indicaciones y fecha -->
                        <VBox style="-fx-padding: 16; -fx-background-color: white;
                              -fx-border-color: #c8ddc8; -fx-border-radius: 6;
                              -fx-background-radius: 6; -fx-spacing: 10;">
                            <VBox spacing="5">
                                <Label style="-fx-text-fill: #555; -fx-font-size: 11;" text="Indicaciones adicionales"/>
                                <TextArea fx:id="txtIndicaciones" prefHeight="70" wrapText="true"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label style="-fx-text-fill: #555; -fx-font-size: 11;" text="Fecha de control"/>
                                <TextField fx:id="txtFechaControl" promptText="dd/mm/aaaa"/>
                            </VBox>
                        </VBox>

                        <Label style="-fx-font-size: 11; -fx-font-style: italic; -fx-text-fill: #777;"
                               text="* Campos obligatorios"/>
                        <Label fx:id="lblMensajeAgg" text=""/>
                        <HBox spacing="10">
                            <Button onAction="#onGuardar"
                                    style="-fx-background-color: #4a9b6f; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-background-radius: 6;
                                           -fx-cursor: hand; -fx-padding: 10 24;" text="💾  Guardar"/>
                            <Button onAction="#onLimpiarAgg"
                                    style="-fx-background-color: #777; -fx-text-fill: white;
                                           -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 24;" text="🧹  Limpiar"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ══ PESTAÑA 2 — Editar ══ -->
            <Tab text="✏  Editar tratamiento">
                <ScrollPane fitToWidth="true">
                    <VBox spacing="16" style="-fx-padding: 24; -fx-background-color: #f0f7f2;">

                        <!-- Animal y estado -->
                        <VBox style="-fx-padding: 16; -fx-background-color: white;
                              -fx-border-color: #c8ddc8; -fx-border-radius: 6;
                              -fx-background-radius: 6; -fx-spacing: 10;">
                            <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4a9b6f;"
                                   text="DATOS GENERALES"/>
                            <Separator/>
                            <HBox spacing="20">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Animal *"/>
                                    <ComboBox fx:id="cmbMascotaE" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Estado"/>
                                    <ComboBox fx:id="cmbEstadoE" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- PLAN TERAPÉUTICO editar -->
                        <VBox style="-fx-padding: 16; -fx-background-color: white;
                              -fx-border-color: #c8ddc8; -fx-border-radius: 6;
                              -fx-background-radius: 6; -fx-spacing: 10;">
                            <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4a9b6f;"
                                   text="PLAN TERAPÉUTICO"/>
                            <Separator/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="txtPrincipioActivoE" promptText="Principio activo"
                                           HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="txtDosisE" promptText="Dosis" prefWidth="90"/>
                                <TextField fx:id="txtViaE" promptText="Vía" prefWidth="90"/>
                                <TextField fx:id="txtFrecuenciaE" promptText="Frecuencia" prefWidth="120"/>
                                <Button text="+ Agregar" onAction="#onAgregarMedicamentoE"
                                        style="-fx-background-color: #4a9b6f; -fx-text-fill: white;
                                               -fx-font-weight: bold; -fx-background-radius: 6;
                                               -fx-cursor: hand; -fx-padding: 8 18;"/>
                            </HBox>
                            <TableView fx:id="tablaMedicamentosE" prefHeight="180">
                                <placeholder>
                                    <Label text="Tabla sin contenido"
                                           style="-fx-font-style: italic; -fx-text-fill: #aaa;"/>
                                </placeholder>
                                <columns>
                                    <TableColumn fx:id="colMedicamentoE" text="Medicamento" prefWidth="300"/>
                                    <TableColumn fx:id="colDosisE"       text="Dosis"       prefWidth="100"/>
                                    <TableColumn fx:id="colViaE"         text="Vía"         prefWidth="100"/>
                                    <TableColumn fx:id="colFrecuenciaE"  text="Frecuencia"  prefWidth="150"/>
                                </columns>
                            </TableView>
                            <Button text="🗑 Quitar seleccionado" onAction="#onQuitarMedicamentoE"
                                    style="-fx-background-color: #e53935; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-background-radius: 6;
                                           -fx-cursor: hand; -fx-padding: 8 18;"/>
                        </VBox>

                        <!-- Indicaciones y fecha -->
                        <VBox style="-fx-padding: 16; -fx-background-color: white;
                              -fx-border-color: #c8ddc8; -fx-border-radius: 6;
                              -fx-background-radius: 6; -fx-spacing: 10;">
                            <VBox spacing="5">
                                <Label style="-fx-text-fill: #555; -fx-font-size: 11;" text="Indicaciones adicionales"/>
                                <TextArea fx:id="txtIndicacionesE" prefHeight="70" wrapText="true"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label style="-fx-text-fill: #555; -fx-font-size: 11;" text="Fecha de control"/>
                                <TextField fx:id="txtFechaControlE" promptText="dd/mm/aaaa"/>
                            </VBox>
                        </VBox>

                        <Label fx:id="lblMensajeEdit" text=""/>
                        <HBox spacing="10">
                            <Button onAction="#onGuardarCambios"
                                    style="-fx-background-color: #4a9b6f; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-background-radius: 6;
                                           -fx-cursor: hand; -fx-padding: 10 24;" text="💾  Guardar cambios"/>
                            <Button onAction="#onLimpiarEditar"
                                    style="-fx-background-color: #777; -fx-text-fill: white;
                                           -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 24;" text="🧹  Limpiar"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ══ PESTAÑA 3 — Lista ══ -->
            <Tab text="📋  Lista de tratamientos">
                <VBox spacing="12" style="-fx-padding: 20; -fx-background-color: #f0f7f2;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#onIrEditar"
                                style="-fx-background-color: #5b8fa8; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 8 16;"
                                text="✏ Editar seleccionado"/>
                        <Button onAction="#onEliminar"
                                style="-fx-background-color: #e53935; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 8 16;"
                                text="🗑 Eliminar"/>
                    </HBox>
                    <Label fx:id="lblMensajeLista" text=""/>
                    <TableView fx:id="tablaTratamientos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMascota"    text="Animal"        prefWidth="130"/>
                            <TableColumn fx:id="colResumen"    text="Medicamentos"  prefWidth="280"/>
                            <TableColumn fx:id="colEstado"     text="Estado"        prefWidth="110"/>
                            <TableColumn fx:id="colFecha"      text="Fecha control" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
