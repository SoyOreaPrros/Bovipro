<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.URL?>

<BorderPane 
    xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.controllers.HistorialController" prefWidth="1000" prefHeight="650">
    <stylesheets><URL value="@estilo.css"/></stylesheets>
        <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="14">
            <Button text="← Dashboard" onAction="#irDashboard" styleClass="btn-back"/>
            <Label text="📋 Historial Clínico" styleClass="header-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="20" style="-fx-padding: 24;">

            <!-- Panel izquierdo: selector de animal -->
            <VBox spacing="12" prefWidth="240"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 20;
                         -fx-border-color: #b0c8b0; -fx-border-radius: 10;">
                <Label text="Animal" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #222222;"/>
                <Separator/>
                <ComboBox fx:id="cmbMascota" maxWidth="Infinity" promptText="-- Selecciona --"/>
                <Button text="📂 Cargar" onAction="#onCargarHistorial" maxWidth="Infinity"
                        style="-fx-background-color: #4a9b6f; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
                <Label fx:id="lblMascota" text="Selecciona un animal para ver su historial."
                       wrapText="true" style="-fx-text-fill: #2d6a4f; -fx-font-size: 12;"/>
            </VBox>

            <!-- Panel derecho: TabPane -->
            <VBox HBox.hgrow="ALWAYS" spacing="0">
                <TabPane fx:id="tabsHistorial" tabClosingPolicy="UNAVAILABLE"
                         style="-fx-tab-min-width: 170; -fx-background-color: #f0f7f2;" VBox.vgrow="ALWAYS">

                    <!-- ══ PESTAÑA 1 — Historial General ══ -->
                    <Tab text="📋  Historial General" closable="false">
                        <VBox spacing="12" style="-fx-padding: 16; -fx-background-color: #f0f7f2;">
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <Button text="➕ Nuevo Registro" onAction="#onNuevoRegistro"
                                        style="-fx-background-color: #5b8fa8; -fx-text-fill: white; -fx-font-weight: bold;
                                               -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 14;"/>
                                <Button text="🗑 Eliminar" onAction="#onEliminarRegistro"
                                        style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-font-weight: bold;
                                               -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 14;"/>
                            </HBox>
                            <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS" prefHeight="280"
                                       style="-fx-border-color: #b0c8b0;">
                                <columns>
                                    <TableColumn fx:id="colFechaH"  text="Fecha"       prefWidth="110"/>
                                    <TableColumn fx:id="colMotivoH" text="Motivo"      prefWidth="200"/>
                                    <TableColumn fx:id="colVetH"    text="Veterinario" prefWidth="130"/>
                                    <TableColumn fx:id="colNotasH"  text="Notas"       prefWidth="200"/>
                                </columns>
                            </TableView>
                            <VBox spacing="6"
                                  style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 14;
                                         -fx-border-color: #b0c8b0; -fx-border-radius: 8;">
                                <Label text="Detalle del Registro"
                                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #222222;"/>
                                <TextArea fx:id="txtDetalle" prefHeight="100" editable="false" wrapText="true"
                                          promptText="Selecciona un registro para ver el detalle..."
                                          style="-fx-text-fill: #222222; -fx-border-color: #b0c8b0;
                                                 -fx-border-radius: 6; -fx-background-radius: 6;"/>
                            </VBox>
                        </VBox>
                    </Tab>

                    <!-- ══ PESTAÑA 2 — Vacunación ══ -->
                    <Tab text="💉  Vacunación" closable="false">
                        <ScrollPane fitToWidth="true" style="-fx-background: #f0f7f2;">
                            <VBox spacing="14" style="-fx-padding: 16; -fx-background-color: #f0f7f2;">

                                <!-- Acciones -->
                                <HBox spacing="10" alignment="CENTER_RIGHT">
                                    <Button text="➕ Agregar Vacuna" onAction="#onAgregarVacuna"
                                            style="-fx-background-color: #4a9b6f; -fx-text-fill: white; -fx-font-weight: bold;
                                                   -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 14;"/>
                                    <Button text="🗑 Eliminar" onAction="#onEliminarVacuna"
                                            style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-font-weight: bold;
                                                   -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 14;"/>
                                </HBox>

                                <!-- Tabla de vacunas -->
                                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;
                                             -fx-border-color: #b0c8b0; -fx-border-radius: 10; -fx-spacing: 10;">
                                    <Label text="REGISTRO DE VACUNACIÓN"
                                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
                                    <Separator/>
                                    <TableView fx:id="tablaVacunas" prefHeight="280"
                                               style="-fx-border-color: #b0c8b0;">
                                        <columns>
                                            <TableColumn fx:id="colVacFecha"    text="Fecha Aplic."   prefWidth="110"/>
                                            <TableColumn fx:id="colVacNombre"   text="Vacuna"         prefWidth="170"/>
                                            <TableColumn fx:id="colVacEnfermedad" text="Contra"       prefWidth="150"/>
                                            <TableColumn fx:id="colVacDosis"    text="Dosis"          prefWidth="80"/>
                                            <TableColumn fx:id="colVacVia"      text="Vía"            prefWidth="70"/>
                                            <TableColumn fx:id="colVacProxima"  text="Próxima Dosis"  prefWidth="120"/>
                                            <TableColumn fx:id="colVacLote"     text="Lote"           prefWidth="90"/>
                                            <TableColumn fx:id="colVacVet"      text="Veterinario"    prefWidth="130"/>
                                        </columns>
                                    </TableView>
                                </VBox>

                                <!-- Resumen estado vacunal -->
                                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;
                                             -fx-border-color: #b0c8b0; -fx-border-radius: 10; -fx-spacing: 10;">
                                    <Label text="ESTADO VACUNAL"
                                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
                                    <Separator/>
                                    <HBox spacing="20">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="Carbón Sintomático" style="-fx-text-fill: #555; -fx-font-size: 11;"/>
                                            <TextField fx:id="txtEstCarbon" editable="false"
                                                       style="-fx-border-color: #b0c8b0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-background-color: #f5f5f5;"/>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="Brucelosis (RB51)" style="-fx-text-fill: #555; -fx-font-size: 11;"/>
                                            <TextField fx:id="txtEstBrucela" editable="false"
                                                       style="-fx-border-color: #b0c8b0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-background-color: #f5f5f5;"/>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="IBR / DVB" style="-fx-text-fill: #555; -fx-font-size: 11;"/>
                                            <TextField fx:id="txtEstIBR" editable="false"
                                                       style="-fx-border-color: #b0c8b0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-background-color: #f5f5f5;"/>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="Leptospira" style="-fx-text-fill: #555; -fx-font-size: 11;"/>
                                            <TextField fx:id="txtEstLepto" editable="false"
                                                       style="-fx-border-color: #b0c8b0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-background-color: #f5f5f5;"/>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="Clostridios" style="-fx-text-fill: #555; -fx-font-size: 11;"/>
                                            <TextField fx:id="txtEstClostridios" editable="false"
                                                       style="-fx-border-color: #b0c8b0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-background-color: #f5f5f5;"/>
                                        </VBox>
                                    </HBox>
                                    <HBox spacing="16">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="Observaciones" style="-fx-text-fill: #444;"/>
                                            <TextArea fx:id="txtObsVacunas" prefHeight="60" wrapText="true" editable="false"
                                                      style="-fx-border-color: #b0c8b0; -fx-border-radius: 6;
                                                             -fx-background-radius: 6; -fx-background-color: #f5f5f5;"/>
                                        </VBox>
                                    </HBox>
                                    <Label fx:id="lblMensajeVac" text="" style="-fx-font-weight: bold;"/>
                                </VBox>

                            </VBox>
                        </ScrollPane>
                    </Tab>

                </TabPane>
            </VBox>

        </HBox>
    </center>
</BorderPane>
