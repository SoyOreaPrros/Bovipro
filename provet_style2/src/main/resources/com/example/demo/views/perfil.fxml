<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.URL?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.example.demo.controllers.PerfilController"
    prefWidth="860" prefHeight="600">
    <stylesheets><URL value="@estilo.css"/></stylesheets>

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="14">
            <Button text="← Dashboard" onAction="#irDashboard" styleClass="btn-back"/>
            <Label text="⚙ Configuración de Seguridad" styleClass="header-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #f0f7f2;">
            <HBox spacing="20" style="-fx-padding: 24;" alignment="TOP_CENTER">

                <!-- Columna izquierda: Cambiar contraseña -->
                <VBox spacing="10" prefWidth="360"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 10;
                             -fx-padding: 20; -fx-border-color: #b0c8b0; -fx-border-radius: 10;">
                    <Label text="🔒 CAMBIAR CONTRASEÑA"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
                    <Separator/>

                    <Label text="Contraseña Actual" style="-fx-text-fill: #444444;"/>
                    <PasswordField fx:id="txtPasswordActual" promptText="••••••••"
                                   style="-fx-border-color: #b0c8b0; -fx-border-radius: 6;
                                          -fx-background-radius: 6; -fx-padding: 8;"/>

                    <Label text="Nueva Contraseña" style="-fx-text-fill: #444444;"/>
                    <PasswordField fx:id="txtPasswordNueva" promptText="••••••••"
                                   style="-fx-border-color: #b0c8b0; -fx-border-radius: 6;
                                          -fx-background-radius: 6; -fx-padding: 8;"/>

                    <Label text="Confirmar Nueva Contraseña" style="-fx-text-fill: #444444;"/>
                    <PasswordField fx:id="txtPasswordConfirm" promptText="••••••••"
                                   style="-fx-border-color: #b0c8b0; -fx-border-radius: 6;
                                          -fx-background-radius: 6; -fx-padding: 8;"/>

                    <Label fx:id="lblMensajePass" text="" style="-fx-font-size: 12;"
                           wrapText="true"/>

                    <Button text="🔒 Cambiar Contraseña" onAction="#onCambiarPassword"
                            maxWidth="Infinity"
                            style="-fx-background-color: #5b8fa8; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-padding: 10; -fx-cursor: hand;">
                        <VBox.margin><Insets top="6"/></VBox.margin>
                    </Button>
                </VBox>

                <!-- Columna derecha: Pregunta de seguridad -->
                <VBox spacing="10" prefWidth="360"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 10;
                             -fx-padding: 20; -fx-border-color: #b0c8b0; -fx-border-radius: 10;">
                    <Label text="❓ PREGUNTA DE SEGURIDAD"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
                    <Separator/>

                    <Label text="Pregunta actual:" style="-fx-text-fill: #666666; -fx-font-size: 11;"/>
                    <Label fx:id="lblPreguntaActual" text=""
                           wrapText="true"
                           style="-fx-text-fill: #1a1a1a; -fx-font-size: 12;
                                  -fx-background-color: #f5f5f5; -fx-background-radius: 6;
                                  -fx-border-color: #b0c8b0; -fx-border-radius: 6;
                                  -fx-padding: 8;" maxWidth="Infinity"/>

                    <Label text="Nueva pregunta de seguridad" style="-fx-text-fill: #444444;"/>
                    <ComboBox fx:id="cmbPregunta" maxWidth="Infinity"
                              style="-fx-border-color: #b0c8b0; -fx-border-radius: 6;
                                     -fx-background-radius: 6;"/>

                    <Label text="Nueva respuesta" style="-fx-text-fill: #444444;"/>
                    <TextField fx:id="txtRespuestaNueva" promptText="Tu respuesta (no importa mayúsculas)"
                               style="-fx-border-color: #b0c8b0; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>

                    <Label text="Confirmar respuesta" style="-fx-text-fill: #444444;"/>
                    <TextField fx:id="txtRespuestaConfirm" promptText="Repite tu respuesta"
                               style="-fx-border-color: #b0c8b0; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 8;"/>

                    <Label fx:id="lblMensajePregunta" text="" style="-fx-font-size: 12;"
                           wrapText="true"/>

                    <Button text="💾 Guardar Pregunta" onAction="#onGuardarPregunta"
                            maxWidth="Infinity"
                            style="-fx-background-color: #4a9b6f; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-padding: 10; -fx-cursor: hand;">
                        <VBox.margin><Insets top="6"/></VBox.margin>
                    </Button>
                </VBox>

            </HBox>
        </ScrollPane>
    </center>
</BorderPane>
