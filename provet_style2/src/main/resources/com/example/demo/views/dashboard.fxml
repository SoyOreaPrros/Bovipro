<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="560" prefWidth="1000" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controllers.DashboardController">
    <stylesheets><URL value="@estilo.css" /></stylesheets>

    <!-- SIDEBAR verde como en Prov -->
    <left>
        <VBox prefWidth="200" styleClass="sidebar">

            <!-- Logo + título -->
            <VBox alignment="CENTER" prefHeight="82.0" prefWidth="200.0" style="-fx-padding: 20 10 16 10; -fx-background-color: #3a8060;">
                <ImageView fitHeight="102.0" fitWidth="111.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@Boviprobuena.png" /></image>
                </ImageView>
            </VBox>

            <Separator style="-fx-background-color: #3a8060;" />

            <!-- Label "Menú de Navegación" como en Prov -->
            <Label style="-fx-font-size: 11; -fx-text-fill: #d4edda; -fx-padding: 10 20 4 20; -fx-font-weight: bold;" text="Menú de Navegación" />
            <Button maxWidth="Infinity" onAction="#irEmergencias" styleClass="btn-sidebar" text="🚑  Emergencias" />

            <Button maxWidth="Infinity" onAction="#irVisitas" styleClass="btn-sidebar" text="🏠  Gestión de Visitas" />
            <Button maxWidth="Infinity" onAction="#irPropietarios" styleClass="btn-sidebar" text="🏡  Propietarios" />
            <Button maxWidth="Infinity" onAction="#irHistorial" styleClass="btn-sidebar" text="📋  Historial" />
            <Button maxWidth="Infinity" onAction="#irBovinos" styleClass="btn-sidebar" text="🐄  Bovinos" />
            <Button maxWidth="Infinity" onAction="#irTratamiento" styleClass="btn-sidebar" text="💊  Tratamiento" />
            <Button maxWidth="Infinity" onAction="#irInventario" styleClass="btn-sidebar" text="📦  Inventario" />
            <Button maxWidth="Infinity" onAction="#irDiagnostico" styleClass="btn-sidebar" text="🔬  Diagnóstico" />
            <Button maxWidth="Infinity" onAction="#irExpediente" styleClass="btn-sidebar" text="📁  Expediente Clínico" />
            <Button maxWidth="Infinity" onAction="#irReportes" styleClass="btn-sidebar" text="📊  Reportes" />
            <Button maxWidth="Infinity" onAction="#irPerfil" styleClass="btn-sidebar" text="🔩 Configuración" />

            <Region VBox.vgrow="ALWAYS" />
            <Separator style="-fx-background-color: #3a8060;" />
            <Button maxWidth="Infinity" onAction="#cerrarSesion" style="-fx-background-color: #e53935; -fx-text-fill: white;                            -fx-font-weight: bold; -fx-padding: 10 20;                            -fx-alignment: CENTER-LEFT; -fx-cursor: hand;                            -fx-border-color: transparent; -fx-background-radius: 0;" text="🔒  Cerrar Sesión" />
        </VBox>
    </left>

    <!-- CONTENIDO principal crema/verde claro -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f7f2;" styleClass="scroll-pane">
            <VBox prefHeight="589.0" prefWidth="798.0" spacing="20" style="-fx-padding: 28; -fx-background-color: #f0f7f2;">

                <Label fx:id="lblBienvenida" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;" />

                <!-- Tarjetas KPI -->
                <HBox spacing="14" />

                <!-- Accesos rápidos -->
                <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;" text="Accesos rápidos" />
                <HBox spacing="12">
                    <Button onAction="#irVisitas" style="-fx-background-color: #4a9b6f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 10 18;" text="➕ Nueva Visita" />
                    <Button onAction="#irBovinos" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 10 18;" text="🐄 Agregar Bovino" />
                    <Button onAction="#irEmergencias" style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 10 18;" text="🚑 Emergencia" />
                    <Button onAction="#irReportes" style="-fx-background-color: #5b8fa8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 10 18;" text="📊 Reportes" />
                </HBox>
                <Label style="-fx-font-size: 13; -fx-text-fill: #4a9b6f;" text="Informacion sobre el STOCK" />
                 <VBox alignment="CENTER" prefHeight="63.0" prefWidth="742.0" spacing="4" styleClass="card">
                     <Label style="-fx-text-fill: #666; -fx-font-size: 12;" text="📦  Stock Bajo" />
                     <Label style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #e65100;" text="2" />
                     <Label style="-fx-text-fill: #e65100; -fx-font-size: 11;" text="Requiere reposición" />
                 </VBox>
            <TableView prefHeight="200.0" prefWidth="200.0">
              <columns>
                <TableColumn prefWidth="740.0" text="Ultimos registros" />
                <TableColumn minWidth="0.0" prefWidth="0.0" text="C2" />
              </columns>
            </TableView>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
